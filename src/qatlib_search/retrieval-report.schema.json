{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QAtlas retrieval report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outcome",
    "snapshot",
    "query",
    "search_scope",
    "results",
    "next_obligations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "outcome": {
      "enum": [
        "EXACT",
        "VIA_BRIDGE",
        "CONDITIONAL",
        "RELATED_ONLY",
        "NO_MATCH"
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "dirty",
        "lean_toolchain",
        "lockfile_git_blob",
        "import_modules"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "lean_toolchain": {
          "type": "string"
        },
        "lockfile_git_blob": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "import_modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text",
        "paper_id",
        "goal_fingerprint"
      ],
      "properties": {
        "kind": {
          "enum": [
            "paper",
            "theorem",
            "natural_language",
            "lean_goal"
          ]
        },
        "text": {
          "type": "string"
        },
        "paper_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "goal_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "search_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "searched_modules",
        "excluded_declarations",
        "upstream_snapshots",
        "limitations"
      ],
      "properties": {
        "searched_modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded_declarations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "upstream_snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "repository",
              "commit",
              "toolchain"
            ],
            "additionalProperties": false,
            "properties": {
              "repository": {
                "type": "string"
              },
              "commit": {
                "type": "string"
              },
              "toolchain": {
                "type": "string"
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "fqn",
          "module",
          "elaborated_type",
          "unfolded_contract",
          "source",
          "paper_refs",
          "scope",
          "missing_premises",
          "bridges",
          "remaining_goals",
          "application_snippet",
          "validation",
          "semantic_review"
        ],
        "properties": {
          "status": {
            "enum": [
              "EXACT",
              "VIA_BRIDGE",
              "CONDITIONAL",
              "RELATED_ONLY"
            ]
          },
          "fqn": {
            "type": "string",
            "minLength": 1
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "elaborated_type": {
            "type": "string",
            "minLength": 1
          },
          "unfolded_contract": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "start_line",
              "end_line"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "start_line": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "paper_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "paper_id",
                "version",
                "locator",
                "relation"
              ],
              "additionalProperties": false,
              "properties": {
                "paper_id": {
                  "type": "string"
                },
                "version": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "locator": {
                  "type": "string"
                },
                "relation": {
                  "enum": [
                    "as_in_paper",
                    "equivalent_reformulation",
                    "generalization",
                    "restricted",
                    "supporting_lemma",
                    "corrected",
                    "unknown"
                  ]
                }
              }
            }
          },
          "scope": {
            "type": "object",
            "required": [
              "model",
              "error_metric",
              "cost_model",
              "scope_note"
            ],
            "additionalProperties": false,
            "properties": {
              "model": {
                "type": "string"
              },
              "error_metric": {
                "type": "string"
              },
              "cost_model": {
                "type": "string"
              },
              "scope_note": {
                "type": "string"
              }
            }
          },
          "missing_premises": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bridges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fqn",
                "module",
                "application_checked",
                "cost_and_error_change"
              ],
              "properties": {
                "fqn": {
                  "type": "string",
                  "minLength": 1
                },
                "module": {
                  "type": "string",
                  "minLength": 1
                },
                "application_checked": {
                  "type": "boolean"
                },
                "cost_and_error_change": {
                  "type": "string"
                }
              }
            }
          },
          "remaining_goals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "application_snippet": {
            "type": [
              "string",
              "null"
            ]
          },
          "validation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "elaborated",
              "application_closed",
              "exit_code",
              "axiom_check_passed",
              "log_path"
            ],
            "properties": {
              "elaborated": {
                "type": "boolean"
              },
              "application_closed": {
                "type": "boolean"
              },
              "exit_code": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "axiom_check_passed": {
                "type": "boolean"
              },
              "log_path": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "semantic_review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "reviewer",
              "evidence_path"
            ],
            "properties": {
              "status": {
                "enum": [
                  "not_reviewed",
                  "reviewed",
                  "needs_changes",
                  "stale"
                ]
              },
              "reviewer": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence_path": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "reviewed"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "reviewer": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence_path": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "EXACT",
                    "VIA_BRIDGE"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "missing_premises": {
                  "maxItems": 0
                },
                "remaining_goals": {
                  "maxItems": 0
                },
                "application_snippet": {
                  "type": "string",
                  "minLength": 1
                },
                "validation": {
                  "properties": {
                    "elaborated": {
                      "const": true
                    },
                    "application_closed": {
                      "const": true
                    },
                    "exit_code": {
                      "const": 0
                    },
                    "axiom_check_passed": {
                      "const": true
                    },
                    "log_path": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "EXACT"
                }
              }
            },
            "then": {
              "properties": {
                "bridges": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "VIA_BRIDGE"
                }
              }
            },
            "then": {
              "properties": {
                "bridges": {
                  "minItems": 1,
                  "items": {
                    "properties": {
                      "application_checked": {
                        "const": true
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "CONDITIONAL"
                }
              }
            },
            "then": {
              "anyOf": [
                {
                  "properties": {
                    "missing_premises": {
                      "minItems": 1
                    }
                  }
                },
                {
                  "properties": {
                    "remaining_goals": {
                      "minItems": 1
                    }
                  }
                }
              ],
              "properties": {
                "validation": {
                  "properties": {
                    "application_closed": {
                      "const": false
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "RELATED_ONLY"
                }
              }
            },
            "then": {
              "properties": {
                "validation": {
                  "properties": {
                    "application_closed": {
                      "const": false
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "next_obligations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "NO_MATCH"
          }
        }
      },
      "then": {
        "properties": {
          "results": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "results": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "EXACT",
              "VIA_BRIDGE"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "snapshot": {
            "properties": {
              "dirty": {
                "const": false
              },
              "lockfile_git_blob": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
              }
            }
          },
          "query": {
            "properties": {
              "goal_fingerprint": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "EXACT"
          }
        }
      },
      "then": {
        "properties": {
          "results": {
            "contains": {
              "properties": {
                "status": {
                  "const": "EXACT"
                }
              }
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "VIA_BRIDGE"
          }
        }
      },
      "then": {
        "properties": {
          "results": {
            "contains": {
              "properties": {
                "status": {
                  "const": "VIA_BRIDGE"
                }
              }
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "CONDITIONAL"
          }
        }
      },
      "then": {
        "properties": {
          "results": {
            "contains": {
              "properties": {
                "status": {
                  "const": "CONDITIONAL"
                }
              }
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "RELATED_ONLY"
          }
        }
      },
      "then": {
        "properties": {
          "results": {
            "contains": {
              "properties": {
                "status": {
                  "const": "RELATED_ONLY"
                }
              }
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "results": {
            "contains": {
              "properties": {
                "status": {
                  "enum": [
                    "EXACT",
                    "VIA_BRIDGE"
                  ]
                }
              }
            },
            "minContains": 1
          }
        }
      },
      "then": {
        "properties": {
          "snapshot": {
            "properties": {
              "dirty": {
                "const": false
              },
              "lockfile_git_blob": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
              }
            }
          },
          "query": {
            "properties": {
              "goal_fingerprint": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
